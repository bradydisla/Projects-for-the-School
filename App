# --- FUNCIONES DE VISUALIZACIÓN ---
def agregar_apartamento_a_lista(index, apt_data):
    frame = tk.Frame(scrollable_frame, bg="#f9f9f9", bd=1, relief="solid", padx=10, pady=10)
    frame.pack(pady=5, fill="x")

    # Frame para la imagen y el texto
    content_frame = tk.Frame(frame, bg="#f9f9f9")
    content_frame.pack(fill="x")

    # Mostrar la imagen si existe y el archivo es válido
    if apt_data.get("fotos") and len(apt_data["fotos"]) > 0:
        imagen_path = apt_data["fotos"][0]
        if os.path.exists(imagen_path):
            try:
                img_original = Image.open(imagen_path)
                img_redimensionada = img_original.resize(TAMAÑO_IMAGEN_PREVIEW, Image.Resampling.LANCZOS)
                img_tk = ImageTk.PhotoImage(img_redimensionada)
                lbl_imagen = tk.Label(content_frame, image=img_tk, bg="#f9f9f9")
                lbl_imagen.image = img_tk  # Prevenir que sea eliminada
                lbl_imagen.pack(side=tk.LEFT, padx=(0, 10))
            except Exception as e:
                # Si hay un error al cargar, muestra un texto en su lugar
                lbl_imagen = tk.Label(content_frame, text="Error\nal cargar\nimagen", bg="#f9f9f9", padx=10)
                lbl_imagen.pack(side=tk.LEFT, padx=(0, 10))
        else:
            lbl_imagen = tk.Label(content_frame, text="Imagen\nno\nencontrada", bg="#f9f9f9", padx=10)
            lbl_imagen.pack(side=tk.LEFT, padx=(0, 10))

    # Frame para el texto del apartamento
    text_frame = tk.Frame(content_frame, bg="#f9f9f9")
    text_frame.pack(side=tk.LEFT, fill="x", expand=True)
    
    lbl_titulo = tk.Label(text_frame, text=apt_data["titulo"], font=("Arial", 14, "bold"), bg="#f9f9f9", anchor="w", fg="#003366")
    lbl_titulo.pack(fill="x")

    lbl_ubicacion = tk.Label(text_frame, text=f"📍 {apt_data['ubicacion']}", font=("Arial", 12), bg="#f9f9f9", anchor="w")
    lbl_ubicacion.pack(fill="x")

    lbl_precio = tk.Label(text_frame, text=apt_data["precio"], font=("Arial", 12, "bold"), bg="#f9f9f9", fg="#008000", anchor="w")
    lbl_precio.pack(fill="x")

    botones_frame = tk.Frame(frame, bg="#f9f9f9")
    botones_frame.pack(pady=5)

    btn_detalles = ttk.Button(botones_frame, text="📄 Ver Detalles", command=lambda i=index: mostrar_detalles(i), style='TButton')
    btn_detalles.pack(side=tk.LEFT, padx=5)

    btn_editar = ttk.Button(botones_frame, text="✏️ Editar", command=lambda i=index: editar_apartamento(i), style='TButton')
    btn_editar.pack(side=tk.LEFT, padx=5)

    btn_eliminar = ttk.Button(botones_frame, text="🗑️ Eliminar", command=lambda i=index: eliminar_apartamento(i), style='TButton')
    btn_eliminar.pack(side=tk.LEFT, padx=5)

# Actualizar lista de apartamentos
def actualizar_lista():
    for widget in scrollable_frame.winfo_children():
        widget.destroy()
    for i, apt in enumerate(apartamentos):
        agregar_apartamento_a_lista(i, apt)

# Función de búsqueda
def buscar_apartamentos(consulta):
    consulta = consulta.lower()
    resultados = [apt for apt in apartamentos if
                  consulta in apt['titulo'].lower() or
                  consulta in apt['ubicacion'].lower() or
                  consulta in apt['descripcion'].lower() or
                  consulta in apt['precio'].lower()]

    for widget in scrollable_frame.winfo_children():
        widget.destroy()

    for i, apt in enumerate(resultados):
        agregar_apartamento_a_lista(apartamentos.index(apt), apt)

# Mostrar todos los apartamentos al iniciar
actualizar_lista()

