apartamentos = cargar_apartamentos()

# --- FUNCIONES DE LA INTERFAZ ---
def mostrar_detalles(index):
    if 0 <= index < len(apartamentos):
        apt = apartamentos[index]
        
        detalles_window = tk.Toplevel(root)
        detalles_window.title(f"Detalles de {apt['titulo']}")
        detalles_window.geometry("500x600")
        detalles_window.configure(bg="#f0f0f0")
        detalles_window.grab_set()

        # Mostrar la primera foto si existe
        if apt.get("fotos") and len(apt["fotos"]) > 0 and os.path.exists(apt["fotos"][0]):
            try:
                img_original = Image.open(apt["fotos"][0])
                img_display = img_original.resize((450, 300), Image.Resampling.LANCZOS)
                img_tk = ImageTk.PhotoImage(img_display)
                lbl_imagen_detalle = tk.Label(detalles_window, image=img_tk, bg="#f0f0f0")
                lbl_imagen_detalle.image = img_tk
                lbl_imagen_detalle.pack(pady=(10, 5))
            except Exception as e:
                pass # No hacer nada si hay un error al cargar

        # Frame para la información de texto
        info_frame = tk.Frame(detalles_window, bg="#f0f0f0")
        info_frame.pack(padx=20, pady=10, fill="both", expand=True)

        lbl_titulo = tk.Label(info_frame, text=apt['titulo'], font=("Arial", 16, "bold"), bg="#f0f0f0", fg="#003366")
        lbl_titulo.pack(pady=(0, 5))

        lbl_ubicacion = tk.Label(info_frame, text=f"📍 Ubicación: {apt['ubicacion']}", font=("Arial", 12), bg="#f0f0f0", anchor="w")
        lbl_ubicacion.pack(fill="x")

        lbl_precio = tk.Label(info_frame, text=f"💰 Precio: {apt['precio']}", font=("Arial", 12), bg="#f0f0f0", anchor="w")
        lbl_precio.pack(fill="x")

        lbl_descripcion = tk.Label(info_frame, text=f"Descripción:\n{apt['descripcion']}", font=("Arial", 12), bg="#f0f0f0", anchor="w", justify="left")
        lbl_descripcion.pack(fill="x", pady=(10, 0))

        detalles_window.protocol("WM_DELETE_WINDOW", lambda: detalles_window.destroy())
        root.wait_window(detalles_window)
    else:
        messagebox.showerror("Error", "Índice de apartamento no válido.")

def eliminar_apartamento(index):
    if 0 <= index < len(apartamentos):
        confirmacion = messagebox.askyesno("Eliminar", "¿Estás seguro de que deseas eliminar este apartamento?")
        if confirmacion:
            apartamentos.pop(index)
            guardar_apartamentos()
            actualizar_lista()
    else:
        messagebox.showerror("Error", "Índice de apartamento no válido.")

def editar_apartamento(index):
    if not (0 <= index < len(apartamentos)):
        messagebox.showerror("Error", "Índice de apartamento no válido.")
        return

    apt = apartamentos[index]
    formulario = tk.Toplevel(root)
    formulario.title(f"Editar Apartamento: {apt['titulo']}")
    formulario.geometry("400x500")
    formulario.configure(bg="#f0f0f0")
    formulario.transient(root)
    formulario.grab_set()
    
    campos = {
        "titulo": "Título:",
        "ubicacion": "Ubicación:",
        "precio": "Precio:",
        "descripcion": "Descripción:"
    }
    
    entradas = {}
    rutas_fotos_temp = apt.get("fotos", []).copy()

    for i, (clave, texto) in enumerate(campos.items()):
        label = tk.Label(formulario, text=texto, font=("Arial", 12), bg="#f0f0f0")
        label.pack(pady=(10 if i == 0 else 5, 0))

        if clave != "descripcion":
            entry = ttk.Entry(formulario, width=40, font=("Arial", 12))
            entry.insert(0, apt[clave])
        else:
            entry = tk.Text(formulario, width=40, height=4, font=("Arial", 12))
            entry.insert("1.0", apt[clave])

        entry.pack(pady=5)
        entradas[clave] = entry

    def seleccionar_fotos():
        nonlocal rutas_fotos_temp
        nuevas_rutas = filedialog.askopenfilenames(
            title="Seleccionar fotos para el apartamento",
            filetypes=[("Archivos de Imagen", "*.png *.jpg *.jpeg *.gif")]
        )
        if nuevas_rutas:
            rutas_fotos_temp = list(nuevas_rutas)
            messagebox.showinfo("Fotos seleccionadas", f"Se han seleccionado {len(rutas_fotos_temp)} fotos.")

    btn_fotos = ttk.Button(formulario, text="📸 Seleccionar/Cambiar Fotos", command=seleccionar_fotos, style='TButton')
    btn_fotos.pack(pady=10)

    def guardar_edicion():
        valores_validos = True
        for clave, widget in entradas.items():
            if clave == "descripcion":
                valor = widget.get("1.0", tk.END).strip()
            else:
                valor = widget.get().strip()

            if not valor:
                messagebox.showwarning("Campos incompletos", "Por favor completa todos los campos.")
                valores_validos = False
                break
            apartamentos[index][clave] = valor
        
        if valores_validos:
            apartamentos[index]["fotos"] = rutas_fotos_temp
            guardar_apartamentos()
            actualizar_lista()
            formulario.destroy()

    btn_guardar = ttk.Button(formulario, text="💾 Guardar Cambios", command=guardar_edicion, style='TButton')
    btn_guardar.pack(pady=20)
    formulario.protocol("WM_DELETE_WINDOW", lambda: formulario.destroy())
    root.wait_window(formulario)

def abrir_formulario():
    formulario = tk.Toplevel(root)
    formulario.title("Agregar Nuevo Apartamento")
    formulario.geometry("400x500")
    formulario.configure(bg="#f0f0f0")
    formulario.transient(root)
    formulario.grab_set()
    
    campos = {
        "titulo": "Título:",
        "ubicacion": "Ubicación:",
        "precio": "Precio:",
        "descripcion": "Descripción:"
    }
    
    entradas = {}
    rutas_fotos_temp = []

    for i, (clave, texto) in enumerate(campos.items()):
        label = tk.Label(formulario, text=texto, font=("Arial", 12), bg="#f0f0f0")
        label.pack(pady=(10 if i == 0 else 5, 0))
        if clave != "descripcion":
            entry = ttk.Entry(formulario, width=40, font=("Arial", 12))
        else:
            entry = tk.Text(formulario, width=40, height=4, font=("Arial", 12))
        entry.pack(pady=5)
        entradas[clave] = entry

    def seleccionar_fotos():
        nonlocal rutas_fotos_temp
        nuevas_rutas = filedialog.askopenfilenames(
            title="Seleccionar fotos para el apartamento",
            filetypes=[("Archivos de Imagen", "*.png *.jpg *.jpeg *.gif")]
        )
        if nuevas_rutas:
            rutas_fotos_temp = list(nuevas_rutas)
            messagebox.showinfo("Fotos seleccionadas", f"Se han seleccionado {len(rutas_fotos_temp)} fotos.")

    btn_fotos = ttk.Button(formulario, text="📸 Seleccionar Fotos", command=seleccionar_fotos, style='TButton')
    btn_fotos.pack(pady=10)

    def guardar_apartamento():
        nuevo_apto = {}
        valores_validos = True
        for clave, widget in entradas.items():
            if clave == "descripcion":
                valor = widget.get("1.0", tk.END).strip()
            else:
                valor = widget.get().strip()

            if not valor:
                messagebox.showwarning("Campos incompletos", "Por favor completa todos los campos.")
                valores_validos = False
                break
            nuevo_apto[clave] = valor
        
        if valores_validos:
            nuevo_apto["fotos"] = rutas_fotos_temp
            apartamentos.append(nuevo_apto)
            guardar_apartamentos()
            actualizar_lista()
            formulario.destroy()

    btn_guardar = ttk.Button(formulario, text="💾 Guardar Apartamento", command=guardar_apartamento, style='TButton')
    btn_guardar.pack(pady=20)
    formulario.protocol("WM_DELETE_WINDOW", lambda: formulario.destroy())
    root.wait_window(formulario)

