# --- FUNCIONES DE GESTIÓN DE DATOS ---
def cargar_apartamentos():
    if os.path.exists(ARCHIVO_JSON):
        try:
            with open(ARCHIVO_JSON, "r", encoding="utf-8") as f:
                data = json.load(f)
                # Asegura que cada apartamento tiene la clave 'fotos'
                for apt in data:
                    if "fotos" not in apt:
                        apt["fotos"] = []
                return data
        except json.JSONDecodeError:
            messagebox.showerror("Error", "Error al cargar el archivo de apartamentos. Se iniciará con datos por defecto.")
            return datos_por_defecto()
    else:
        return datos_por_defecto()

